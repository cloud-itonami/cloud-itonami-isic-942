{:paths ["src" "test"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.10.914"}}
 :aliases {
  ;; clj-kondo from deps (no binary), errors fail CI. Added because this repo
  ;; could not be linted at all -- across this fleet an absent or broken :lint
  ;; alias is what let misplaced docstrings, dead code and even a false-green
  ;; test verdict survive unreported (cloud-itonami-isic-561/563/920).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; clojure -M:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by driving the REAL
  ;;      stack (operation/flow -> advisor -> governor -> store). Refuses to
  ;;      write a page from a run with zero :governor-hold facts.
  :render-html {:main-opts ["-m" "tradeunionorg.render-html"]}
  :test {:extra-paths ["test"]}}}
